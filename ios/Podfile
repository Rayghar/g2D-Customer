# Global iOS platform for the project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS_SEND'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match /FLUTTER_ROOT\=(.*)/
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |t|
    # Keep Flutter/Xcode defaults first, then layer our settings so they "win"
    flutter_additional_ios_build_settings(t)

    t.build_configurations.each do |config|
      # 1) Align all pods to iOS 15.0 to avoid Xcode 15 warnings & mismatches
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # 2) Enable Swift parser support for `public import` across all pods
      #    (required by IQKeyboard* with Xcode 15.4 / Swift 5.10)
      existing = config.build_settings['OTHER_SWIFT_FLAGS']
      if existing.nil? || existing.empty?
        config.build_settings['OTHER_SWIFT_FLAGS'] = '$(inherited) -enable-experimental-feature AccessLevelOnImport'
      else
        flags = existing.is_a?(Array) ? existing : existing.to_s.split(' ')
        unless flags.include?('-enable-experimental-feature') && flags.include?('AccessLevelOnImport')
          flags += ['-enable-experimental-feature', 'AccessLevelOnImport']
        end
        config.build_settings['OTHER_SWIFT_FLAGS'] = flags.join(' ')
      end
    end
  end
end
