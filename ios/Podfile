# Global iOS platform for the project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS_SEND'] = 'true'

project 'Runner', {
  'Debug'   => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Install Flutter + plugin pods (let FlutterFire pick Firebase 11.x as required)
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Pods that need the Swift experimental feature for 'public import'
  iq_pods = %w[
    IQTextInputViewNotification
    IQKeyboardCore
    IQKeyboardNotification
    IQKeyboardToolbar
    IQKeyboardToolbarManager
    IQKeyboardReturnManager
    IQTextView
  ]

  installer.pods_project.targets.each do |t|
    # Keep Flutter defaults
    flutter_additional_ios_build_settings(t)

    t.build_configurations.each do |config|
      # Raise too-low min targets to 12.0 (silences warnings, satisfies Firebase 11.x)
      min = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if min && Gem::Version.new(min) < Gem::Version.new('12.0')
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
      end

      # Enable AccessLevelOnImport only for the IQ* pods
      if iq_pods.include?(t.name)
        existing = config.build_settings['OTHER_SWIFT_FLAGS'] || '$(inherited)'
        config.build_settings['OTHER_SWIFT_FLAGS'] = "#{existing} -enable-experimental-feature AccessLevelOnImport"
      end
    end
  end
end
