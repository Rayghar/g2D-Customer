# Global iOS platform for the project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS_SEND'] = 'true'

project 'Runner', {
  'Debug'   => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match /FLUTTER_ROOT\=(.*)/
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Install Flutter + plugin pods
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # --- Force Swift-5–compatible Firebase (avoid Swift 6-only 'sending' keyword) ---
  # Pin only the Firebase pods you actually use; adjust if your app uses more/less.
  pod 'FirebaseCore',          '< 11.0'
  pod 'FirebaseAuth',          '< 11.0'
  pod 'FirebaseFirestore',     '< 11.0'
  pod 'FirebaseMessaging',     '< 11.0'
  pod 'FirebaseInstallations', '< 11.0'
  pod 'FirebaseSharedSwift',   '< 11.0'  # guard the Swift-6 module introduced in 11.x

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # IQKeyboard* pods that require 'AccessLevelOnImport' under Swift 5.10 / Xcode 15.4
  iq_pods = %w[
    IQTextInputViewNotification
    IQKeyboardCore
    IQKeyboardNotification
    IQKeyboardToolbar
    IQKeyboardToolbarManager
    IQKeyboardReturnManager
    IQTextView
  ]

  installer.pods_project.targets.each do |t|
    # Keep Flutter/Xcode defaults first
    flutter_additional_ios_build_settings(t)

    t.build_configurations.each do |config|
      # 1) Align all pods to iOS 15.0 (silences old min-target warnings)
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # 2) Enable parser support for 'public import' ONLY for the IQ* pods that need it
      if iq_pods.include?(t.name)
        existing = config.build_settings['OTHER_SWIFT_FLAGS'] || '$(inherited)'
        config.build_settings['OTHER_SWIFT_FLAGS'] = "#{existing} -enable-experimental-feature AccessLevelOnImport"
      end
    end
  end
end
